# ============================================================
# AD-Marketplace — Environment Variables Template
# ============================================================
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local or any file containing real secrets.
# ============================================================

# ------------------------------------------------------------
# Supabase — PUBLIC (safe to expose to the browser)
# ------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ------------------------------------------------------------
# Supabase — PRIVATE (server-side only, NEVER use NEXT_PUBLIC_ prefix)
# Compatibility env name: use a Supabase Secret API Key (sb_secret_...),
# which replaces the legacy JWT service_role key. It has elevated privileges,
# must remain server-only, and MUST NOT reach the browser.
# ------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------
# Application
# ------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------
# Didit KYC & Age Verification — PRIVATE (server-side only)
# ------------------------------------------------------------
# Set in production with credentials from business.didit.me
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=
DIDIT_WEBHOOK_SECRET=
DIDIT_API_BASE_URL=https://verification.didit.me

# Development/Testing only: set to 'true' to explicitly force MockVerificationProvider
# USE_MOCK_KYC_PROVIDER=false

# ------------------------------------------------------------
# Node environment (set automatically by Next.js in most cases)
# ------------------------------------------------------------
# NODE_ENV=development

# ============================================================
# FASE 11 — Security Additions
# ============================================================

# ABUSE_PEPPER: Required for content report IP pseudonymization
# HMAC secret for reporter hash generation.
# Generate: openssl rand -hex 32
# Server-side only (NOT prefixed with NEXT_PUBLIC_)
ABUSE_PEPPER=

# ANALYTICS_RATE_LIMIT_SECRET: Required for IP-derived analytics rate limiting
# Prevents analytics flooding without persisting raw IPs.
# Generate: openssl rand -hex 32
# Server-side only (NOT prefixed with NEXT_PUBLIC_)
ANALYTICS_RATE_LIMIT_SECRET=

# AUTH_INTENT_SECRET: HMAC key for signed OAuth intent cookies (R11.5A).
# Server-side only (NOT prefixed with NEXT_PUBLIC_).
# If not set, falls back to ANALYTICS_RATE_LIMIT_SECRET or SUPABASE_SERVICE_ROLE_KEY.
# Generate: openssl rand -hex 32
AUTH_INTENT_SECRET=

# BILLING_WEBHOOK_SECRET: Required when integrating a real payment provider.
# Set to the provider's webhook signing secret.
# REAL_PAYMENT_PROVIDER_INTEGRATED = false (current state)
# REAL_PAYMENT_PROCESSING_ENABLED = false (current state)
# MOCK_PAYMENT_PROVIDER_ONLY = true (current state)
BILLING_WEBHOOK_SECRET=

# ============================================================
# FASE 12.2A — Public Marketplace Shell
# ============================================================

# MARKETPLACE_NAME: Consumer-facing brand name displayed in Header, Footer, and all public UI.
# NOT a secret — but server-side only (no NEXT_PUBLIC_ prefix) because the brand
# may change before production launch and we don't want to hardcode it in the client bundle.
# Development: falls back to "Marketplace" placeholder with a console warning.
# Production: throws at runtime if not set — must be configured before deploying.
# Pass to Client Components as a prop from Server Components, never import lib/brand directly.
MARKETPLACE_NAME=Marketplace

# Official privacy-rights contact displayed on public legal pages.
# Required by the legal production-readiness check. Do not invent a value.
PRIVACY_CONTACT_EMAIL=

# ATTRIBUTION_SIGNING_SECRET: HMAC-SHA256 key for signed WhatsApp attribution tokens.
# Required before FASE 12.2E (WhatsApp conversion Route Handler) is activated.
# NOT required for public shell rendering (Header/Footer render without it).
# Minimum 32 characters. Generate: openssl rand -hex 32
# Server-side only (NEVER prefix with NEXT_PUBLIC_). This IS a secret.
ATTRIBUTION_SIGNING_SECRET=
